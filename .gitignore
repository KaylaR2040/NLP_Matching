# MACOS
.DS_Store

# API KEYS & CREDENTIALS
.env
.env.*
!.env.example
wrapper/backend/.env
wrapper/backend/.env.*
!wrapper/backend/.env.example

# DOCUMENTATION (access credentials and developer-only docs — never commit)
./documentation/.*

# Claude Code local session settings (may contain allowed commands with inline secrets)
.claude/settings.local.json

# PYTHON
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
*.sqlite3
*.egg-info/
.venv/

# FLUTTER
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.flutter_sdk/
.dart_tool/

# FIREBASE
.firebase/
firebase-debug.log*

# USER DATA (mentor/mentee PII — never commit)
/data/*
nlp_project/data/
nlp_project/state/
nlp_project/output/
wrapper/backend/data/mentors/
wrapper/backend/data/dev_file_backups/

# DUPLICATE — nlp_project is at repo root; backend copy is built by Docker at deploy time
wrapper/backend/nlp_project/

# OTHER
.idea/
.vscode/settings.json
